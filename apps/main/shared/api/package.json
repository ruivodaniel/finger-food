{
  "name": "@apps/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "pnpm tsx scripts/seed-db.ts",
    "test:unit": "vitest run --config ./vitest.unit.config.ts --passWithNoTests",
    "test:integration": "vitest run --config ./vitest.integration.config.ts",
    "lint": "NODE_OPTIONS=\"--import tsx/esm\" eslint . --ext .ts,.tsx",
    "prettier": "prettier --write . --ignore-path ../../../.prettierignore",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "smsdev": "npx @relay-works/sms-dev start"
  },
  "dependencies": {
    "@configs/access-control": "workspace:*",
    "@configs/notifications": "workspace:*",
    "@configs/product": "workspace:*",
    "@configs/user-organization-mgmt": "workspace:*",
    "@hono/node-server": "1.14.3",
    "@hono/zod-validator": "0.4.3",
    "@paralleldrive/cuid2": "^3.0.0",
    "@libs/gated-scoped-ac": "workspace:*",
    "@modules/notifications": "workspace:*",
    "@libs/storage": "workspace:*",
    "@modules/user-organization-mgmt": "workspace:*",
    "@libs/workflows": "workspace:*",
    "nodemailer": "^7.0.12",
    "dotenv": "16.5.0",
    "drizzle-kit": "0.31.1",
    "drizzle-orm": "0.43.1",
    "drizzle-zod": "0.8.2",
    "hono": "4.12.17",
    "pg": "8.16.0",
    "pino": "9.7.0",
    "pino-pretty": "13.0.0",
    "tsx": "4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "8.15.2",
    "esbuild": "0.25.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.4"
  }
}
