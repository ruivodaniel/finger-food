#############################
##### Application Config ####
#############################
# src/env.ts is the only place env is read — this file documents exactly the
# vars it declares, nothing more. Adding a var here without adding it to the
# zod schema means it is not read by the app.

# Runtime environment: test | development | staging | production (default: development)
NODE_ENV=development
# Port the API listens on (default: 3000)
PORT=3001
# pino level: fatal | error | warn | info | debug | trace (optional, default: info)
LOG_LEVEL=debug
# json (default) or pretty — pretty enables the pino-pretty transport (optional)
LOG_FORMAT=pretty


#############################
##### Database Config #######
#############################
# Postgres connection string — required (compose maps host 5436 -> container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/finger_food


#############################
##### Queue #################
#############################
# inline (default): deliveries run in-process right after commit. outbox: the
# workflow_intent row is written in the mutation's transaction and run in this
# process after commit; the orchestrator's schedule calls /api/m2m/workflow-intents/reconcile.
QUEUE_MODE=inline
WORKFLOW_INTENT_CONCURRENCY=10
# The secret the orchestrator signs its service JWT with (HS256, shared).
# SERVICE_JWT_SECRET=dev-service-secret-change-me


#############################
##### CORS ##################
#############################
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3001
# Optional regex matched against the request Origin, in addition to the list above
# CORS_ORIGIN_PATTERN=^https://.*\.prowd\.care$


#############################
##### Auth (uom module) #####
#############################
# Social login — a provider mounts only when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=


#############################
##### Delivery ##############
#############################
# Email (notifications, invitations and the sign-in codes, over SMTP
# directly) — maildev in dev. Unset SMTP_HOST = warn-log no-op.
SMTP_HOST=localhost
SMTP_PORT=1026
EMAIL_FROM=noreply@localhost
# SMS: SMS-Dev in dev (pnpm smsdev), Twilio otherwise
SMS_DEV_URL=http://localhost:4001
# Sender label shown in the SMS-Dev inbox
SMS_FROM=FingerFood
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Where web-main renders the invitation-accept page
WEB_APP_URL=http://localhost:5175


#############################
##### Object storage ########
#############################
# Avatar/org-logo uploads (@libs/storage via the uom module's storage port).
# Dev defaults target the compose LocalStack; in real AWS set the bucket and
# leave AWS_ENDPOINT unset (credentials come from IRSA).
AWS_REGION=us-east-1
AWS_BUCKET_NAME=finger-food-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# AWS_ENDPOINT=https://localhost.localstack.cloud:4568
