# =============================================================================
# SECRETS — gitignored, per-developer
# =============================================================================
# These are injected into .env at runtime via dotenv.
# Each developer creates their own .env.secrets with their credentials.

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional — set up at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (optional — requires Apple Developer account)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Resend email delivery. RESEND_WEBHOOK_SECRET is required for deployed webhooks.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# Twilio SMS (real delivery — optional for local dev; remove SMS_DEV_URL from .env to use Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
