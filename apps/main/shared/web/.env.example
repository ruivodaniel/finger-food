#############################
#### Application Config #####
#############################
# API base URL for backend requests ex: http://localhost:3001
VITE_API_URL=http://localhost:3001

# VAPID public key for web push (optional — disables web push UI if absent)
# Generate with: npx web-push generate-vapid-keys --json
VITE_VAPID_PUBLIC_KEY=

# Push token environment. Local/develop/stage should use sandbox; production should use production.
VITE_PUSH_ENVIRONMENT=sandbox
