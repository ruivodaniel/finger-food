#############################
#### Application Config #####
#############################
# API base URL for backend requests ex: http://localhost:3000
VITE_API_URL=http://localhost:3000

# VAPID public key for web push (optional — disables web push UI if absent)
# Generate with: npx web-push generate-vapid-keys --json
VITE_VAPID_PUBLIC_KEY=

# Push token environment. Local/develop/stage should use sandbox; production should use production.
VITE_PUSH_ENVIRONMENT=sandbox

# The environment's name (development, develop, staging, production). Unset is Vite's mode:
# development under `vite dev`, production in a build. Anything but production shows the
# Stripe test card beside the buttons that open Stripe.
# VITE_APP_ENVIRONMENT=development

# Dictation in the chat (transcribed in the browser). Where the speech model is served from.
# Unset: /models/ of this app in development (write it with `pnpm prepare:assets`), no dictation otherwise.
# VITE_WHISPER_MODEL_BASE_URL=https://cdn.example.com/models/
