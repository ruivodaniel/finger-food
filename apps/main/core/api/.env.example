#############################
##### Application Config ####
#############################
# src/env.ts is the only place env is read — this file documents exactly the
# vars it declares, nothing more. Adding a var here without adding it to the
# zod schema means it is not read by the app.

# Runtime environment: test | development | staging | production (default: development)
NODE_ENV=development
# Port the API listens on (default: 3000)
PORT=3011
# pino level: fatal | error | warn | info | debug | trace (optional, default: info)
LOG_LEVEL=debug
# json (default) or pretty — pretty enables the pino-pretty transport (optional)
LOG_FORMAT=pretty


#############################
##### Database Config #######
#############################
# Postgres connection string — required (compose maps host 5437 -> container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/finger_food


#############################
##### Queue #################
#############################
# inline (default): deliveries run in-process right after commit. outbox: the
# workflow_intent row is written in the mutation's transaction and run in this
# process after commit; the orchestrator's schedule calls /api/m2m/workflow-intents/reconcile.
QUEUE_MODE=inline
WORKFLOW_INTENT_CONCURRENCY=10
# The secret the orchestrator signs its service JWT with (HS256, shared).
# Also signs main's chat run requests to the orchestrator.
# SERVICE_JWT_SECRET=dev-service-secret-change-me


#############################
##### Chatbot ###############
#############################
# Each link stays off until its vars are set: without them a message gets an
# error answer (no orchestrator) or its answer never reaches the browser (no open API).
# Where main starts chat runs (POST /pipelines/chat/runs)
# ORCHESTRATOR_URL=http://localhost:4003
# Where main listens to the chat events (GET /events)
# OPEN_API_URL=http://localhost:4002
# Main's Ed25519 private key (PKCS#8 PEM, newlines written as \n): signs the
# delegation a run carries and main's token for the open API, which holds the
# matching public key. Generate one per developer:
#   openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
# MAIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n


#############################
##### CORS ##################
#############################
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Optional regex matched against the request Origin, in addition to the list above
# CORS_ORIGIN_PATTERN=^https://.*\.prowd\.care$


#############################
##### Auth (uom module) #####
#############################
# Dev convention: the API runs on PORT=3005 — the module's kratos.yml courier
# webhook and web-main's VITE_API_URL both point there.
# Ory Kratos endpoints (defaults match the module's compose fragment)
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
# Must match X-Courier-Secret in the module's kratos.yml (default: dev-courier-secret)
KRATOS_COURIER_SMS_SECRET=dev-courier-secret
# Social login — a provider mounts only when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=


#############################
##### Delivery ##############
#############################
# Email (notifications + invitations; kratos sends its own codes via SMTP
# directly) — maildev in dev. Unset SMTP_HOST = warn-log no-op.
SMTP_HOST=localhost
SMTP_PORT=1027
EMAIL_FROM=noreply@localhost
# SMS: SMS-Dev in dev (pnpm smsdev), Twilio otherwise
SMS_DEV_URL=http://localhost:4001
# Sender label shown in the SMS-Dev inbox
SMS_FROM=Prowd
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Where web-main renders the invitation-accept page
WEB_APP_URL=http://localhost:5174


#############################
##### Object storage ########
#############################
# Avatar/org-logo uploads (@libs/storage via the uom module's storage port).
# Dev defaults target the compose LocalStack; in real AWS set the bucket and
# leave AWS_ENDPOINT unset (credentials come from IRSA).
AWS_REGION=us-east-1
AWS_BUCKET_NAME=prowd-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# AWS_ENDPOINT=https://localhost.localstack.cloud:4569


#############################
##### Stripe (payment) ######
#############################
# The payment slice mounts Stripe only when the secret key is set; without it
# credits, allowances and welcome grants work and the Stripe-backed routes
# answer 503. These are the shared development sandbox's values (sandbox
# "sursum", test mode only): every developer uses them as they are. Never put
# a live key (sk_live_) here.
STRIPE_SECRET_KEY=
# Signing secrets of POST /api/webhooks/stripe and of the Connect endpoint
# POST /api/webhooks/stripe/connect. Locally one listener forwards both and
# signs with the sandbox's secret, the same for every developer, so no
# `stripe login` is needed (CLI 1.53+ refuses to listen without --events):
#   stripe listen --api-key "$STRIPE_SECRET_KEY" \
#     --events checkout.session.completed,checkout.session.async_payment_succeeded,invoice.paid,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,charge.refunded,charge.dispute.funds_withdrawn,charge.dispute.funds_reinstated,account.updated \
#     --forward-to localhost:3000/api/webhooks/stripe \
#     --forward-connect-to localhost:3000/api/webhooks/stripe/connect
STRIPE_WEBHOOK_SECRET=whsec_5525c862d5d4105cb211274d0e00c04038d8adc74b6a7e249ddb51d27c0afd25
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_5525c862d5d4105cb211274d0e00c04038d8adc74b6a7e249ddb51d27c0afd25
# One Stripe price id per catalog key (shared/configs/payment), as
# STRIPE_PRICE_<KEY>. With the key set, every plan and bundle needs one or the
# API refuses to boot.
STRIPE_PRICE_STARTER=price_1UPuiwDNkNQw824z0ZZpAMXg
STRIPE_PRICE_PRO=price_1UPujYDNkNQw824ztDd1YjJn
STRIPE_PRICE_SMALL=price_1UPukZDNkNQw824zyt8BXmpC
STRIPE_PRICE_LARGE=price_1UPulBDNkNQw824zdEyciePo
