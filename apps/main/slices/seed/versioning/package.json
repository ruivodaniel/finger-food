{
  "name": "@modules/versioning",
  "version": "0.1.0",
  "description": "Versioning \u2014 the capsule tables and everything about history (versions, branches, compare, merge, releases), for any entity in the versioned map",
  "type": "module",
  "exports": {
    "./shared": {
      "types": "./shared/index.ts",
      "import": "./shared/index.ts"
    },
    "./api": {
      "types": "./api/index.ts",
      "import": "./api/index.ts"
    },
    "./models": {
      "types": "./api/models/index.ts",
      "import": "./api/models/index.ts",
      "default": "./api/models/index.ts"
    },
    "./web": {
      "types": "./web/index.ts",
      "import": "./web/index.ts"
    }
  },
  "files": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libs/versioning": "workspace:*"
  },
  "peerDependencies": {
    "@hono/zod-validator": ">=0.4.0",
    "@libs/web-components": "workspace:*",
    "@libs/web-layouts": "workspace:*",
    "@tanstack/react-query": "^5.77.0",
    "drizzle-orm": ">=0.30.0",
    "drizzle-zod": ">=0.8.0",
    "hono": "^4.12.17",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@libs/web-components": {
      "optional": true
    },
    "@libs/web-layouts": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/react": "^18.0.0 || ^19.0.0",
    "drizzle-kit": "0.31.1",
    "drizzle-zod": "0.8.2",
    "typescript": "^5.0.0",
    "vitest": "^3.1.4"
  }
}
