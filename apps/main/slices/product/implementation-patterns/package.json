    "react-dom": {
      "optional": true
    },
    "@modules/shared": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.1.4"
  }
}
