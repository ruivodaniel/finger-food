{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@libs/knowledge/previewer-editors/*": ["../../libs/knowledge/previewer-editors/*"],
      "@codemirror/*": ["./node_modules/@codemirror/*"],
      "@lezer/highlight": ["./node_modules/@lezer/highlight"],
      "@libs/web-components": ["../../libs/ui/web/index.ts"],
      "@libs/web-components-src/*": ["../../libs/ui/web/primitives/components/*"],
      "@libs/web-layouts": ["../../libs/ui/web/primitives/layouts/index.ts"],
      "@libs/value-types": ["../../libs/value-types/src/index.ts"],
      "@libs/ui-types": ["../../libs/ui/types/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
