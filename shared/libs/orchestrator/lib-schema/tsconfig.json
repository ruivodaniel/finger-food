{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No DOM and no node: the schema is read on both sides, so it may use neither.
    // A `node:*` import or a `window` reference fails to compile here.
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["."],
  "exclude": ["__test__", "node_modules", "vitest.config.ts"]
}
