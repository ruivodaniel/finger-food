{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Node types, because server workers run binaries and touch the disk. A
    // worker that declares "client" must not: the frontend lint control and
    // the browser typecheck hold that line, not this file.
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["."],
  "exclude": ["__test__", "node_modules", "vitest.config.ts"]
}
