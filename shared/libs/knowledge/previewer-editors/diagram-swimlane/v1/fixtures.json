     "lane": "data",
     "order": 3,
     "attachedTo": "s3",
     "language": "javascript",
     "code": {
      "id": "s3c1",
      "code": "ui_data  organizations@4  → uiNodeId: node:organizations\nui_node  node:organizations\nroute    { path: \"/organizations\",\n           uiNodeId: \"node:organizations\" }"
     }
    },
