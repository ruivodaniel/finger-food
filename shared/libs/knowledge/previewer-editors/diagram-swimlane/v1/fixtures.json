     "attachedTo": "s3",
     "language": "javascript",
     "code": {
      "id": "s3c0",
      "code": "ui_prototype \"b1c97273\" = {\n  worldId: \"world:acme\",\n  t: 0,\n  initialUiDataId: \"organizations@4\",\n  initialStoreState: {\n    session: \"u-samantha\",\n    activeOrganization: \"o-platform\" },\n  initialParams: {},\n  recordedRequests: [ three ]\n}"
