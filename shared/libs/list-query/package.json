{
  "name": "@libs/list-query",
  "version": "0.1.0",
  "description": "Reusable list-query contract: pagination + sort + search. Isomorphic core, Drizzle/Zod helpers for backend, URLSearchParams serializer for frontend.",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "zod": "^4.4.3",
    "react": "^18.0.0 || ^19.0.0",
    "@tanstack/react-router": "^1.120.0",
    "@libs/web-components": "workspace:*"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": { "optional": true },
    "zod": { "optional": true },
    "react": { "optional": true },
    "@tanstack/react-router": { "optional": true },
    "@libs/web-components": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.1.4"
  },
  "keywords": [
    "pagination",
    "sort",
    "list",
    "query",
    "drizzle",
    "zod"
  ]
}
