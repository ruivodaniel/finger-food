{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": [
    "index.ts",
    "react-overrides.d.ts",
    "primitives/**/*.ts",
    "primitives/**/*.tsx",
    "patterns/**/*.ts",
    "patterns/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "primitives/layouts"
  ]
}
