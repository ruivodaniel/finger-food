   "props": {
    "dir": "col",
    "align": "center",
    "scale": "2xl"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "neutral"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "center",
        "scale": "md",
        "wrap": true
       },
       "children": [
        {
         "type": "AlertDialog",
         "children": [
          {
           "type": "AlertDialogTrigger",
           "children": [
            {
             "type": "Button",
             "props": {
              "emphasis": "secondary",
              "children": "Open neutral alert",
              "data-testid": "alert-dialog-neutral-1-btn"
             }
            }
           ],
           "props": {
            "asChild": true
           }
          },
          {
           "type": "AlertDialogContent",
           "children": [
            {
             "type": "Header",
             "children": [
              {
               "type": "AlertDialogTitle",
               "props": {
                "children": "Are you sure?"
               }
              },
              {
               "type": "AlertDialogDescription",
               "props": {
                "children": "This action will proceed with the selected operation. Please confirm you want to continue."
               }
              }
             ]
            },
            {
             "type": "Footer",
             "children": [
              {
               "type": "AlertDialogCancel",
               "props": {
                "children": "Cancel"
               }
              },
              {
               "type": "AlertDialogAction",
               "on": {
                "click": [
                 {
                  "set": {
                   "state": "neutral_open",
                   "to": false
                  }
                 }
                ]
               },
               "props": {
                "children": "Continue",
                "data-testid": "alert-dialog-neutral-2-card"
               }
              }
             ]
            }
           ],
           "props": {
            "status": "neutral"
           }
          }
         ],
         "on": {
          "openChange": [
           {
            "set": {
             "state": "neutral_open",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "open": {
           "bind": "state.neutral_open"
          },
          "data-testid": "alert-dialog-neutral-3-dialog"
         }
        }
       ]
      }
     ]
    },
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "warning"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
