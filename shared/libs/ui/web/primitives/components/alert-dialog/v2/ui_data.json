{
 "id": "ui-data-primitive-alert-dialog",
 "version": 1,
 "uiNodeId": "ui-node-primitive-alert-dialog",
 "kind": "component",
 "name": "primitive-alert-dialog",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "primitive-alert-dialog",
  "version": 1,
  "surface": "web",
  "state": {
   "neutral_open": false,
   "warning_open": false,
   "destructive_open": false
  },
  "root": {
