{
 "id": "ui-data-primitive-collapsible",
 "version": 1,
 "uiNodeId": "ui-node-primitive-collapsible",
 "kind": "component",
 "name": "primitive-collapsible",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "primitive-collapsible",
  "version": 1,
  "surface": "web",
  "state": {
   "open_open": true,
   "closed_open": false
  },
  "root": {
   "type": "Stack",
   "props": {
    "dir": "col",
    "align": "center",
    "scale": "2xl"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "basic"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "center",
        "scale": "md",
        "wrap": true
       },
       "children": [
        {
         "type": "Collapsible",
         "children": [
          {
           "type": "CollapsibleTrigger",
           "children": [
            {
             "type": "Button",
             "props": {
              "scale": "sm",
              "children": "Toggle",
              "data-testid": "collapsible-basic-1-btn"
             }
            }
           ],
           "props": {
            "asChild": true
           }
          },
          {
           "type": "CollapsibleContent",
           "children": [
            {
             "type": "Text",
             "props": {
              "as": "p",
              "children": "This section is open by default. Click the button above to collapse it."
             }
            }
           ]
          }
         ],
         "on": {
          "openChange": [
           {
            "set": {
             "state": "open_open",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "open": {
           "bind": "state.open_open"
          },
          "data-testid": "collapsible-basic-2-card"
         }
        },
        {
         "type": "Collapsible",
         "children": [
          {
           "type": "CollapsibleTrigger",
           "children": [
            {
             "type": "Button",
             "props": {
              "scale": "sm",
              "children": "Toggle",
              "data-testid": "collapsible-basic-3-btn"
             }
            }
           ],
           "props": {
            "asChild": true
           }
          },
          {
           "type": "CollapsibleContent",
           "children": [
            {
             "type": "Text",
             "props": {
              "as": "p",
              "children": "This section is closed by default. Click the button above to expand it."
             }
            }
           ]
          }
         ],
         "on": {
          "openChange": [
           {
            "set": {
             "state": "closed_open",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "open": {
           "bind": "state.closed_open"
          },
          "data-testid": "collapsible-basic-4-card"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
