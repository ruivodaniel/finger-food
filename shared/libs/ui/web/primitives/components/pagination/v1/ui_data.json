{
 "id": "ui-data-primitive-pagination",
 "version": 1,
 "uiNodeId": "ui-node-primitive-pagination",
 "kind": "component",
 "name": "primitive-pagination",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "primitive-pagination",
  "version": 1,
  "surface": "web",
  "state": {
   "page": 2
  },
  "root": {
   "type": "Stack",
   "props": {
    "dir": "col",
    "align": "center",
    "scale": "2xl"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "Previous (disabled) | 1 | 2 (selected) | 3 | … | 12 | Next"
       }
      },
      {
       "type": "Pagination",
       "children": [
        {
         "type": "PaginationContent",
         "children": [
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationPrevious",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": {
                  "if": [
                   {
                    "gt": [
                     {
                      "bind": "state.page"
                     },
                     1
                    ]
                   },
                   {
                    "sub": [
                     {
                      "bind": "state.page"
                     },
                     1
                    ]
                   },
                   1
                  ]
                 }
                }
               }
              ]
             },
             "props": {
              "data-testid": "pagination-page-previous-btn"
             }
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationLink",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": 1
                }
               }
              ]
             },
             "props": {
              "isActive": {
               "eq": [
                {
                 "bind": "state.page"
                },
                1
               ]
              },
              "children": "1",
              "data-testid": "pagination-page-1-btn"
             }
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationLink",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": 2
                }
               }
              ]
             },
             "props": {
              "isActive": {
               "eq": [
                {
                 "bind": "state.page"
                },
                2
               ]
              },
              "children": "2",
              "data-testid": "pagination-page-2-btn"
             }
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationLink",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": 3
                }
               }
              ]
             },
             "props": {
              "isActive": {
               "eq": [
                {
                 "bind": "state.page"
                },
                3
               ]
              },
              "children": "3",
              "data-testid": "pagination-page-3-btn"
             }
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationEllipsis"
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationLink",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": 12
                }
               }
              ]
             },
             "props": {
              "isActive": {
               "eq": [
                {
                 "bind": "state.page"
                },
                12
               ]
              },
              "children": "12",
              "data-testid": "pagination-page-12-btn"
             }
            }
           ]
          },
          {
           "type": "PaginationItem",
           "children": [
            {
             "type": "PaginationNext",
             "on": {
              "click": [
               {
                "set": {
                 "state": "page",
                 "to": {
                  "if": [
                   {
                    "lt": [
                     {
                      "bind": "state.page"
                     },
                     12
                    ]
                   },
                   {
                    "add": [
                     {
                      "bind": "state.page"
                     },
                     1
                    ]
                   },
                   12
                  ]
                 }
                }
               }
              ]
             },
             "props": {
              "data-testid": "pagination-page-next-btn"
             }
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
