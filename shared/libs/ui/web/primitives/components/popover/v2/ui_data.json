{
 "id": "ui-data-primitive-popover",
 "version": 1,
 "uiNodeId": "ui-node-primitive-popover",
 "kind": "component",
 "name": "primitive-popover",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "primitive-popover",
  "version": 1,
  "surface": "web",
  "state": {
   "basic_open": false,
   "form_open": false,
   "form_value_value": ""
  },
  "root": {
   "type": "Stack",
   "props": {
    "dir": "col",
    "align": "center",
    "scale": "2xl"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "basic"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "center",
        "scale": "md",
        "wrap": true
       },
       "children": [
        {
         "type": "Popover",
         "children": [
          {
           "type": "PopoverTrigger",
           "children": [
            {
             "type": "Button",
             "props": {
              "emphasis": "secondary",
              "children": "Open popover",
              "data-testid": "popover-basic-1-btn"
             }
            }
           ],
           "props": {
            "asChild": true
           }
          },
          {
           "type": "PopoverContent",
           "children": [
            {
             "type": "PopoverHeader",
             "children": [
              {
               "type": "PopoverTitle",
               "props": {
                "children": "Popover title"
               }
              },
              {
               "type": "PopoverDescription",
               "props": {
                "children": "This is a basic popover with a title and some descriptive text inside."
               }
              }
             ]
            }
           ]
          }
         ],
         "on": {
          "openChange": [
           {
            "set": {
             "state": "basic_open",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "open": {
           "bind": "state.basic_open"
          },
          "data-testid": "popover-basic-2-menu"
         }
        }
       ]
      }
     ]
    },
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "form-like"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "center",
        "scale": "md",
        "wrap": true
       },
       "children": [
        {
         "type": "Popover",
         "children": [
          {
           "type": "PopoverTrigger",
           "children": [
            {
             "type": "Button",
             "props": {
              "emphasis": "secondary",
              "children": "Open form popover",
              "data-testid": "popover-form-like-1-btn"
             }
            }
           ],
           "props": {
            "asChild": true
           }
          },
          {
           "type": "PopoverContent",
           "children": [
            {
             "type": "PopoverHeader",
             "children": [
              {
               "type": "PopoverTitle",
               "props": {
                "children": "Quick edit"
               }
              },
              {
               "type": "PopoverDescription",
               "props": {
                "children": "Update the value below and press enter to save."
               }
              }
             ]
            },
            {
             "type": "Input",
             "on": {
              "change": [
               {
                "set": {
                 "state": "form_value_value",
                 "to": {
                  "bind": "event"
                 }
                }
               }
              ]
             },
             "props": {
              "scale": "md",
              "placeholder": "Enter a value...",
              "value": {
               "bind": "state.form_value_value"
              },
              "data-testid": "popover-form-like-2-input"
             }
            }
           ]
          }
         ],
         "on": {
          "openChange": [
           {
            "set": {
             "state": "form_open",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "open": {
           "bind": "state.form_open"
          },
          "data-testid": "popover-form-like-3-menu"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
