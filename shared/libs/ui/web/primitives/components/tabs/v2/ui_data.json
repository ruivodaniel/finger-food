{
 "id": "ui-data-primitive-tabs",
 "version": 1,
 "uiNodeId": "ui-node-primitive-tabs",
 "kind": "component",
 "name": "primitive-tabs",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "primitive-tabs",
  "version": 1,
  "surface": "web",
  "state": {
   "default_value": "all"
  },
  "root": {
   "type": "Stack",
   "props": {
    "dir": "col",
    "align": "center",
    "scale": "2xl"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "dir": "col",
      "align": "center",
      "scale": "sm"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "element": "type--body-extra-small",
        "emphasis": "quiet",
        "children": "default \u2014 All / Active / Inactive / Disabled"
       }
      },
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "center",
        "scale": "md",
        "wrap": true
       },
       "children": [
        {
         "type": "Tabs",
         "children": [
          {
           "type": "TabsList",
           "children": [
            {
             "type": "TabsTrigger",
             "props": {
              "value": "all",
              "children": "All"
             }
            },
            {
             "type": "TabsTrigger",
             "props": {
              "value": "active",
              "children": "Active"
             }
            },
            {
             "type": "TabsTrigger",
             "props": {
              "value": "inactive",
              "children": "Inactive"
             }
            },
            {
             "type": "TabsTrigger",
             "props": {
              "value": "disabled",
              "disabled": true,
              "children": "Disabled"
             }
            }
           ]
          }
         ],
         "on": {
          "valueChange": [
           {
            "set": {
             "state": "default_value",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         },
         "props": {
          "value": {
           "bind": "state.default_value"
          },
          "data-testid": "tabs-default-all-active-inactive-disabled-1-tab"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
