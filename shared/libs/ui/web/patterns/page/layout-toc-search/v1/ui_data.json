{
 "id": "ui-data-pattern-page-layout-toc-search",
 "version": 1,
 "uiNodeId": "ui-node-pattern-page-layout-toc-search",
 "kind": "page",
 "name": "layout-toc-search",
 "document": {
  "kind": "page",
  "schemaVersion": 1,
  "name": "layout-toc-search",
  "version": 1,
  "surface": "web",
  "state": {
   "open": false,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light",
   "selected": "baseline",
   "query": ""
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "expand": "overlay",
    "account": "separate",
    "withOrganizations": false,
    "withModes": false,
    "toggleAt": "top",
    "backLabel": "PROWD"
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   },
   "slots": {
    "children": [
     {
      "type": "DoubleSidebarLayout",
      "props": {
       "scale": "md",
       "pageHeaderContent": {
        "type": "Stack",
        "props": {
         "dir": "row",
         "align": "center",
         "justify": "between",
         "size": "fill"
        },
        "children": [
         {
          "type": "Text",
          "props": {
           "as": "span",
           "element": "type--heading3",
           "children": "Glossary"
          }
         },
         {
          "type": "Button",
          "props": {
           "scale": "sm",
           "children": "New term",
           "emphasis": "primary",
           "data-testid": "layout-toc-search-new-term-btn"
          }
         }
        ]
       },
       "pageLeftSidebarContent": {
        "type": "SidebarProvider",
        "props": {
         "open": true
        },
        "children": [
         {
          "type": "Sidebar",
          "props": {
           "collapsible": "none"
          },
          "children": [
           {
            "type": "SidebarHeader",
            "children": [
             {
              "type": "Input",
              "props": {
               "type": "search",
               "value": {
                "bind": "state.query"
               },
               "placeholder": "Search terms\u2026",
               "startIcon": {
                "type": "Icon",
                "props": {
                 "name": "search"
                }
               },
               "data-testid": "layout-toc-search-search-terms-input"
              },
              "on": {
               "change": [
                {
                 "set": {
                  "state": "query",
                  "to": {
                   "bind": "event"
                  }
                 }
                }
               ]
              }
             }
            ]
           },
           {
            "type": "SidebarContent",
            "children": [
             {
              "type": "SidebarGroup",
              "children": [
               {
                "type": "ListTree",
                "props": {
                 "items": [
                  {
                   "id": "a",
                   "label": "A",
                   "children": [
                    {
                     "id": "access-request",
                     "label": "Access request"
                    },
                    {
                     "id": "approval",
                     "label": "Approval"
                    }
                   ]
                  },
                  {
                   "id": "b",
                   "label": "B",
                   "children": [
                    {
                     "id": "baseline",
                     "label": "Baseline"
                    },
                    {
                     "id": "batch",
                     "label": "Batch"
                    }
                   ]
                  },
                  {
                   "id": "c",
                   "label": "C",
                   "children": [
                    {
                     "id": "change-request",
                     "label": "Change request"
                    },
                    {
                     "id": "checkpoint",
                     "label": "Checkpoint"
                    }
                   ]
                  },
                  {
                   "id": "r",
                   "label": "R",
                   "children": [
                    {
                     "id": "release",
                     "label": "Release"
                    },
                    {
                     "id": "review",
                     "label": "Review"
                    }
                   ]
                  }
                 ],
                 "selectedId": {
                  "bind": "state.selected"
                 },
                 "data-testid": "contents-tree-menu",
                 "indent": 16,
                 "renderNode": {
                  "type": "Text",
                  "props": {
                   "as": "span",
                   "element": "type--body-small",
                   "children": {
                    "bind": "item.label"
                   }
                  }
                 }
                },
                "on": {
                 "select": [
                  {
                   "set": {
                    "state": "selected",
                    "to": {
                     "bind": "event.id"
                    }
                   }
                  }
                 ]
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       "mainContainerContent": {
        "type": "Stack",
        "props": {
         "dir": "col",
         "scale": "xl"
        },
        "children": [
         {
          "type": "Card",
          "children": [
           {
            "type": "Content",
            "children": [
             {
              "type": "Stack",
              "props": {
               "dir": "col",
               "scale": "md"
              },
              "children": [
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "type": "Card",
          "children": [
           {
            "type": "Content",
            "children": [
             {
              "type": "Stack",
              "props": {
               "dir": "col",
               "scale": "md"
              },
              "children": [
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      }
     }
    ]
   }
  }
 }
}
