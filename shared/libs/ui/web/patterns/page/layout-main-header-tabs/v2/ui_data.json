{
 "id": "ui-data-pattern-page-layout-main-header-tabs",
 "version": 1,
 "uiNodeId": "ui-node-pattern-page-layout-main-header-tabs",
 "kind": "page",
 "name": "layout-main-header-tabs",
 "document": {
  "kind": "page",
  "schemaVersion": 1,
  "name": "layout-main-header-tabs",
  "version": 1,
  "surface": "web",
  "state": {
   "open": false,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light",
   "selected": "list",
   "tab": "screen"
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "expand": "overlay",
    "account": "separate",
    "withOrganizations": false,
    "withModes": false,
    "toggleAt": "top",
    "backLabel": "PROWD"
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   },
   "slots": {
    "children": [
     {
      "use": {
       "component": "DoubleSidebarMainHeaderLayout",
       "version": "latest"
      },
      "args": {
       "away": {
        "obj": {
         "pageLeftSidebar": {
          "bind": "store.layout.expanded"
         }
        }
       }
      },
      "slots": {
       "pageLeftSidebar": [
        {
         "type": "SidebarProvider",
         "props": {
          "open": true
         },
         "children": [
          {
           "type": "Sidebar",
           "props": {
            "collapsible": "none"
           },
           "children": [
            {
             "type": "SidebarHeader",
             "children": [
              {
               "type": "Text",
               "props": {
                "as": "span",
                "element": "type--heading4",
                "children": "Screens"
               }
              }
             ]
            },
            {
             "type": "SidebarContent",
             "children": [
              {
               "type": "SidebarGroup",
               "children": [
                {
                 "type": "ListTree",
                 "props": {
                  "items": [
                   {
                    "id": "sign-in",
                    "label": "Sign in",
                    "children": [
                     {
                      "id": "email",
                      "label": "Email"
                     },
                     {
                      "id": "code",
                      "label": "Code"
                     }
                    ]
                   },
                   {
                    "id": "orders",
                    "label": "Orders",
                    "children": [
                     {
                      "id": "list",
                      "label": "List"
                     },
                     {
                      "id": "detail",
                      "label": "Detail"
                     },
                     {
                      "id": "refund",
                      "label": "Refund"
                     }
                    ]
                   },
                   {
                    "id": "settings",
                    "label": "Settings",
                    "children": [
                     {
                      "id": "members",
                      "label": "Members"
                     },
                     {
                      "id": "billing",
                      "label": "Billing"
                     }
                    ]
                   }
                  ],
                  "selectedId": {
                   "bind": "state.selected"
                  },
                  "data-testid": "contents-tree-menu",
                  "indent": 16,
                  "renderNode": {
                   "type": "Text",
                   "props": {
                    "as": "span",
                    "element": "type--body-small",
                    "children": {
                     "bind": "item.label"
                    }
                   }
                  }
                 },
                 "on": {
                  "select": [
                   {
                    "set": {
                     "state": "selected",
                     "to": {
                      "bind": "event.id"
                     }
                    }
                   }
                  ]
                 }
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ],
       "mainHeader": [
        {
         "type": "Stack",
         "props": {
          "dir": "row",
          "align": "center",
          "justify": "between",
          "size": "fill"
         },
         "children": [
          {
           "type": "Stack",
           "props": {
            "dir": "row",
            "align": "center",
            "scale": "sm"
           },
           "children": [
            {
             "type": "Button",
             "props": {
              "scale": "sm",
              "emphasis": "tertiary",
              "buttonType": "icon",
              "startIcon": "panelLeft",
              "aria-label": "Show the sidebars",
              "data-testid": "layout-main-header-tabs-show-sidebars-btn"
             },
             "when": {
              "bind": "store.layout.expanded"
             },
             "on": {
              "click": [
               {
                "dispatch": {
                 "action": "layout.setExpanded",
                 "args": {
                  "expanded": false
                 }
                }
               }
              ]
             }
            },
            {
             "type": "Text",
             "props": {
              "as": "span",
              "element": "type--heading3",
              "children": "Orders: list"
             }
            }
           ]
          },
          {
           "type": "Button",
           "props": {
            "scale": "sm",
            "emphasis": "tertiary",
            "buttonType": "icon",
            "startIcon": {
             "if": [
              {
               "bind": "store.layout.expanded"
              },
              "minimize",
              "maximize"
             ]
            },
            "aria-label": "Expand",
            "data-testid": "layout-main-header-tabs-expand-btn"
           },
           "on": {
            "click": [
             {
              "dispatch": {
               "action": "layout.setExpanded",
               "args": {
                "expanded": {
                 "not": [
                  {
                   "bind": "store.layout.expanded"
                  }
                 ]
                }
               }
              }
             }
            ]
           }
          }
         ]
        }
       ],
       "secondMainHeader": [
        {
         "type": "Tabs",
         "props": {
          "value": {
           "bind": "state.tab"
          },
          "data-testid": "layout-main-header-tabs-tabs-tabs"
         },
         "children": [
          {
           "type": "TabsList",
           "props": {},
           "children": [
            {
             "type": "TabsTrigger",
             "props": {
              "value": "screen",
              "children": "Screen",
              "data-testid": "layout-main-header-tabs-screen-tab"
             }
            },
            {
             "type": "TabsTrigger",
             "props": {
              "value": "notes",
              "children": "Notes",
              "data-testid": "layout-main-header-tabs-notes-tab"
             }
            },
            {
             "type": "TabsTrigger",
             "props": {
              "value": "history",
              "children": "History",
              "data-testid": "layout-main-header-tabs-history-tab"
             }
            }
           ]
          }
         ],
         "on": {
          "valueChange": [
           {
            "set": {
             "state": "tab",
             "to": {
              "bind": "event"
             }
            }
           }
          ]
         }
        }
       ],
       "mainBody": [
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "scale": "xl"
         },
         "children": [
          {
           "type": "Stack",
           "props": {
            "dir": "col",
            "scale": "xl"
           },
           "children": [
            {
             "type": "Card",
             "children": [
              {
               "type": "Content",
               "children": [
                {
                 "type": "Stack",
                 "props": {
                  "dir": "col",
                  "scale": "md"
                 },
                 "children": [
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "sm"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "lg"
                   }
                  }
                 ]
                }
               ]
              }
             ]
            },
            {
             "type": "Card",
             "children": [
              {
               "type": "Content",
               "children": [
                {
                 "type": "Stack",
                 "props": {
                  "dir": "col",
                  "scale": "md"
                 },
                 "children": [
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "sm"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  },
                  {
                   "type": "Skeleton",
                   "props": {
                    "scale": "md"
                   }
                  }
                 ]
                }
               ]
              }
             ]
            }
           ],
           "when": {
            "eq": [
             {
              "bind": "state.tab"
             },
             "screen"
            ]
           }
          },
          {
           "type": "Card",
           "children": [
            {
             "type": "Content",
             "children": [
              {
               "type": "Stack",
               "props": {
                "dir": "col",
                "scale": "md"
               },
               "children": [
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                }
               ]
              }
             ]
            }
           ],
           "when": {
            "eq": [
             {
              "bind": "state.tab"
             },
             "notes"
            ]
           }
          },
          {
           "type": "Card",
           "children": [
            {
             "type": "Content",
             "children": [
              {
               "type": "Stack",
               "props": {
                "dir": "col",
                "scale": "md"
               },
               "children": [
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                }
               ]
              }
             ]
            }
           ],
           "when": {
            "eq": [
             {
              "bind": "state.tab"
             },
             "history"
            ]
           }
          }
         ]
        }
       ]
      }
     }
    ]
   }
  }
 }
}