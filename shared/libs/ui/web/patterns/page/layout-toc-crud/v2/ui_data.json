{
 "id": "ui-data-pattern-page-layout-toc-crud",
 "version": 1,
 "uiNodeId": "ui-node-pattern-page-layout-toc-crud",
 "kind": "page",
 "name": "layout-toc-crud",
 "document": {
  "kind": "page",
  "schemaVersion": 1,
  "name": "layout-toc-crud",
  "version": 1,
  "surface": "web",
  "state": {
   "open": false,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light",
   "selected": "launch-onboarding"
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "expand": "overlay",
    "account": "separate",
    "withOrganizations": false,
    "withModes": false,
    "toggleAt": "top",
    "backLabel": "PROWD"
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   },
   "slots": {
    "children": [
     {
      "use": {
       "component": "DoubleSidebarLayout",
       "version": "latest"
      },
      "slots": {
       "pageHeader": [
        {
         "type": "Stack",
         "props": {
          "dir": "row",
          "align": "center",
          "justify": "between",
          "size": "fill"
         },
         "children": [
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--heading3",
            "children": "Goals"
           }
          },
          {
           "type": "Button",
           "props": {
            "scale": "sm",
            "children": "Share",
            "emphasis": "primary",
            "data-testid": "layout-toc-crud-share-btn"
           }
          }
         ]
        }
       ],
       "pageLeftSidebar": [
        {
         "type": "SidebarProvider",
         "props": {
          "open": true
         },
         "children": [
          {
           "type": "Sidebar",
           "props": {
            "collapsible": "none"
           },
           "children": [
            {
             "type": "SidebarHeader",
             "children": [
              {
               "type": "Button",
               "props": {
                "scale": "sm",
                "children": "New goal",
                "emphasis": "secondary",
                "buttonType": "icon-text",
                "startIcon": "add",
                "data-testid": "layout-toc-crud-new-goal-btn"
               }
              }
             ]
            },
            {
             "type": "SidebarContent",
             "children": [
              {
               "type": "SidebarGroup",
               "children": [
                {
                 "type": "ListTree",
                 "props": {
                  "items": [
                   {
                    "id": "first-quarter",
                    "label": "First quarter",
                    "children": [
                     {
                      "id": "launch-onboarding",
                      "label": "Launch onboarding"
                     },
                     {
                      "id": "reduce-churn",
                      "label": "Reduce churn"
                     }
                    ]
                   },
                   {
                    "id": "second-quarter",
                    "label": "Second quarter",
                    "children": [
                     {
                      "id": "open-two-regions",
                      "label": "Open two regions"
                     },
                     {
                      "id": "hire-support-team",
                      "label": "Hire support team"
                     }
                    ]
                   },
                   {
                    "id": "backlog",
                    "label": "Backlog"
                   }
                  ],
                  "selectedId": {
                   "bind": "state.selected"
                  },
                  "data-testid": "contents-tree-menu",
                  "indent": 16,
                  "renderNode": {
                   "type": "Stack",
                   "props": {
                    "dir": "row",
                    "align": "center",
                    "justify": "between",
                    "size": "fill"
                   },
                   "children": [
                    {
                     "type": "Text",
                     "props": {
                      "as": "span",
                      "element": "type--body-small",
                      "children": {
                       "bind": "item.label"
                      }
                     }
                    },
                    {
                     "type": "Button",
                     "props": {
                      "scale": "sm",
                      "emphasis": "tertiary",
                      "buttonType": "icon",
                      "startIcon": "more",
                      "aria-label": "Actions",
                      "data-testid": "layout-toc-crud-actions-btn"
                     }
                    }
                   ]
                  }
                 },
                 "on": {
                  "select": [
                   {
                    "set": {
                     "state": "selected",
                     "to": {
                      "bind": "event.id"
                     }
                    }
                   }
                  ]
                 }
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ],
       "mainContainer": [
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "scale": "xl"
         },
         "children": [
          {
           "type": "Card",
           "children": [
            {
             "type": "Content",
             "children": [
              {
               "type": "Stack",
               "props": {
                "dir": "col",
                "scale": "md"
               },
               "children": [
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "lg"
                 }
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "type": "Card",
           "children": [
            {
             "type": "Content",
             "children": [
              {
               "type": "Stack",
               "props": {
                "dir": "col",
                "scale": "md"
               },
               "children": [
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "sm"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                },
                {
                 "type": "Skeleton",
                 "props": {
                  "scale": "md"
                 }
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    ]
   }
  }
 }
}