{
 "id": "ui-data-pattern-page-layout-header-main",
 "version": 1,
 "uiNodeId": "ui-node-pattern-page-layout-header-main",
 "kind": "page",
 "name": "layout-header-main",
 "document": {
  "kind": "page",
  "schemaVersion": 1,
  "name": "layout-header-main",
  "version": 1,
  "surface": "web",
  "state": {
   "open": false,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light"
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "expand": "overlay",
    "account": "separate",
    "withOrganizations": false,
    "withModes": false,
    "toggleAt": "top",
    "backLabel": "PROWD"
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   },
   "slots": {
    "children": [
     {
      "type": "SingleSidebarLayout",
      "props": {
       "pageHeaderContent": {
        "type": "Stack",
        "props": {
         "dir": "row",
         "align": "center",
         "justify": "between",
         "size": "fill"
        },
        "children": [
         {
          "type": "Text",
          "props": {
           "as": "span",
           "element": "type--heading3",
           "children": "Orders"
          }
         },
         {
          "type": "Button",
          "props": {
           "scale": "sm",
           "children": "New order",
           "emphasis": "primary",
           "data-testid": "layout-header-main-new-order-btn"
          }
         }
        ]
       },
       "mainContainerContent": {
        "type": "Stack",
        "props": {
         "dir": "col",
         "scale": "xl"
        },
        "children": [
         {
          "type": "Card",
          "children": [
           {
            "type": "Content",
            "children": [
             {
              "type": "Stack",
              "props": {
               "dir": "col",
               "scale": "md"
              },
              "children": [
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "lg"
                }
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "type": "Card",
          "children": [
           {
            "type": "Content",
            "children": [
             {
              "type": "Stack",
              "props": {
               "dir": "col",
               "scale": "md"
              },
              "children": [
               {
                "type": "Skeleton",
                "props": {
                 "scale": "sm"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               },
               {
                "type": "Skeleton",
                "props": {
                 "scale": "md"
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      }
     }
    ]
   }
  }
 }
}
