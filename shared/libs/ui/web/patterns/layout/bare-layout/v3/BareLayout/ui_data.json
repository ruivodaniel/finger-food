{
 "id": "ui-data-pattern-layout-bare-layout-barelayout",
 "version": 1,
 "uiNodeId": "ui-node-pattern-layout-bare-layout-barelayout",
 "kind": "component",
 "name": "BareLayout",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "BareLayout",
  "version": 1,
  "surface": "web",
  "params": [
   "scale",
   "away"
  ],
  "emits": [
   "scrollDirection"
  ],
  "slots": [
   "mainContainer"
  ],
  "root": {
   "type": "Page",
   "children": [
    {
     "type": "PageBody",
     "children": [
      {
       "type": "Main",
       "children": [
        {
         "type": "MainContent",
         "children": [
          {
           "type": "MainBody",
           "on": {
            "scrollDirection": [
             {
              "emit": {
               "event": "scrollDirection",
               "payload": {
                "direction": {
                 "bind": "event"
                }
               }
              }
             }
            ]
           },
           "children": [
            {
             "type": "MainContainer",
             "props": {
              "scale": {
               "bind": "scale"
              }
             },
             "children": [
              {
               "type": "Slot",
               "props": {
                "name": "mainContainer"
               }
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 }
}