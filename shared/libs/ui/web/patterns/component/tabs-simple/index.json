{
 "kind": "component",
 "schemaVersion": 1,
 "name": "tabs-simple",
 "version": 1,
 "surface": "web",
 "measure": "md",
 "state": {
  "tab": "account"
 },
 "root": {
  "type": "Tabs",
  "props": {
   "className": "w-full",
   "value": {
    "bind": "state.tab"
   }
  },
  "children": [
   {
    "type": "TabsList",
    "props": {},
    "children": [
     {
      "type": "TabsTrigger",
      "props": {
       "value": "account",
       "children": "Account"
      }
     },
     {
      "type": "TabsTrigger",
      "props": {
       "value": "security",
       "children": "Security"
      }
     },
     {
      "type": "TabsTrigger",
      "props": {
       "value": "notifications",
       "children": "Notifications"
      }
     }
    ]
   },
   {
    "type": "TabsContent",
    "props": {
     "value": "account"
    },
    "children": [
     {
      "type": "Text",
      "props": {
       "as": "p",
       "element": "type--body-small",
       "emphasis": "quiet",
       "children": "Manage your account settings and preferences."
      }
     }
    ]
   },
   {
    "type": "TabsContent",
    "props": {
     "value": "security"
    },
    "children": [
     {
      "type": "Text",
      "props": {
       "as": "p",
       "element": "type--body-small",
       "emphasis": "quiet",
       "children": "Update your password and security options."
      }
     }
    ]
   },
   {
    "type": "TabsContent",
    "props": {
     "value": "notifications"
    },
    "children": [
     {
      "type": "Text",
      "props": {
       "as": "p",
       "element": "type--body-small",
       "emphasis": "quiet",
       "children": "Configure your notification preferences."
      }
     }
    ]
   }
  ],
  "on": {
   "valueChange": [
    {
     "set": {
      "state": "tab",
      "to": {
       "bind": "event"
      }
     }
    }
   ]
  }
 }
}
