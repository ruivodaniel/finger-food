{
 "id": "ui-data-pattern-component-list-stacked-items-orders-orderrow",
 "version": 1,
 "uiNodeId": "ui-node-pattern-component-list-stacked-items-orders-orderrow",
 "kind": "component",
 "name": "OrderRow",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "OrderRow",
  "version": 1,
  "surface": "web",
  "params": [
   "id",
   "date",
   "customer",
   "email",
   "items",
   "channel",
   "amount",
   "statusText"
  ],
  "root": {
   "type": "ListItem",
   "props": {
    "className": "gap-3"
   },
   "children": [
    {
     "type": "ListItemContent",
     "props": {},
     "children": [
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "scale": "lg"
       },
       "children": [
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "className": "w-36",
          "scale": "2xs"
         },
         "children": [
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--code",
            "children": {
             "bind": "id"
            }
           }
          },
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--body-extra-small",
            "emphasis": "quiet",
            "children": {
             "bind": "date"
            }
           }
          }
         ]
        },
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "size": "fill",
          "scale": "2xs"
         },
         "children": [
          {
           "type": "ListItemTitle",
           "props": {
            "children": {
             "bind": "customer"
            }
           }
          },
          {
           "type": "ListItemDescription",
           "props": {
            "children": {
             "bind": "email"
            }
           }
          }
         ]
        },
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "className": "w-24",
          "scale": "2xs"
         },
         "children": [
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--body-small",
            "children": {
             "bind": "items"
            }
           }
          },
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--body-extra-small",
            "emphasis": "quiet",
            "children": {
             "bind": "channel"
            }
           }
          }
         ]
        },
        {
         "type": "Stack",
         "props": {
          "dir": "col",
          "align": "end",
          "className": "w-28",
          "scale": "2xs"
         },
         "children": [
          {
           "type": "Text",
           "props": {
            "as": "span",
            "element": "type--numbers-small",
            "children": {
             "bind": "amount"
            }
           }
          },
          {
           "type": "Badge",
           "props": {
            "emphasis": "quiet",
            "status": {
             "if": [
              {
               "eq": [
                {
                 "bind": "statusText"
                },
                "Paid"
               ]
              },
              "success",
              {
               "if": [
                {
                 "eq": [
                  {
                   "bind": "statusText"
                  },
                  "Pending"
                 ]
                },
                "warning",
                {
                 "if": [
                  {
                   "eq": [
                    {
                     "bind": "statusText"
                    },
                    "Shipped"
                   ]
                  },
                  "info",
                  {
                   "if": [
                    {
                     "eq": [
                      {
                       "bind": "statusText"
                      },
                      "Refunded"
                     ]
                    },
                    "error"
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            },
            "scale": "xs",
            "children": {
             "bind": "statusText"
            }
           }
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "ListItemAction",
     "props": {},
     "children": [
      {
       "type": "Text",
       "props": {
        "as": "span",
        "element": "type--body-small",
        "emphasis": "quiet"
       },
       "children": [
        {
         "type": "Icon",
         "props": {
          "name": "chevronRight",
          "size": "sm"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
