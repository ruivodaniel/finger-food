             "state": "last",
             "to": {
              "bind": "event.id"
             }
            }
           }
          ],
          "signOut": [
           {
            "set": {
             "state": "last",
             "to": "sign-out"
            }
           }
          ]
         }
        }
       ]
      }
     ]
    }
   ]
  }
 }
}
