       "event": "signOut",
       "payload": {}
      }
     }
    ]
   },
   "slots": {
    "picture": [
     {
      "use": {
       "component": "OrganizationAvatar",
       "version": "latest"
      },
      "args": {
       "id": {
        "bind": "activeId"
       },
       "name": {
        "first": [
         {
          "pluck": [
           {
            "filter": [
             {
              "bind": "organizations"
             },
             {
              "eq": [
               {
                "bind": "item.id"
               },
               {
                "bind": "activeId"
               }
              ]
             }
            ]
           },
           "name"
