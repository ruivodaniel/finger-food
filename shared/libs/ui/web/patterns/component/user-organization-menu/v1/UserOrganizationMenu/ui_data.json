        "organization"
       ]
      },
      {
       "first": [
        {
         "pluck": [
          {
           "filter": [
            {
             "bind": "organizations"
            },
            {
             "eq": [
              {
               "bind": "item.id"
              },
              {
               "bind": "activeId"
              }
             ]
            }
           ]
          },
          "name"
         ]
        }
       ]
      }
     ]
    },
    "detail": {
