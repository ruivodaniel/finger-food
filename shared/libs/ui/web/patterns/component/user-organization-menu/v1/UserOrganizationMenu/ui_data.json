     },
     {
      "type": "DropdownMenuItem",
      "props": {
       "data-testid": "user-organization-menu-add-btn"
      },
      "children": [
       {
        "type": "Icon",
        "props": {
         "name": "add"
        }
       },
       {
        "type": "Text",
        "props": {
         "as": "span",
         "element": "type--body",
         "children": {
          "bind": "addLabel"
         }
        }
       }
      ],
      "when": {
       "exists": [
        {
         "bind": "addLabel"
        }
       ]
      },
      "on": {
       "select": [
        {
         "emit": {
          "event": "organizationAdd",
          "payload": {}
         }
        }
       ]
      }
     },
     {
      "type": "Separator"
     }
    ]
   }
  }
 }
}
