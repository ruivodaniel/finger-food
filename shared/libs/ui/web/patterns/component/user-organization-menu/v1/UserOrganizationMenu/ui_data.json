    },
    "items": {
     "bind": "items"
    },
    "modes": {
     "bind": "modes"
    },
    "mode": {
     "bind": "mode"
    },
    "modeLayout": {
     "bind": "modeLayout"
    },
    "modeLabel": {
     "bind": "modeLabel"
    },
    "modeIcon": {
     "bind": "modeIcon"
    },
    "compact": {
     "bind": "compact"
    },
    "trigger": {
     "bind": "trigger"
    },
    "header": {
     "bind": "header"
    },
    "manageLabel": {
     "bind": "manageLabel"
    },
    "itemsLabel": {
     "bind": "itemsLabel"
    },
    "triggerIcon": {
     "bind": "triggerIcon"
    },
    "customPicture": {
     "eq": [
