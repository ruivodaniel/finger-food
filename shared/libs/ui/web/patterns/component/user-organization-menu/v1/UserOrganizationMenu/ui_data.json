                "bind": "item.id"
               },
               {
                "bind": "activeId"
               }
              ]
             }
            ]
           },
           "image"
          ]
         }
        ]
       },
       "scale": "sm",
       "layout": "image",
       "width": "hug"
      },
      "when": {
       "eq": [
        {
         "bind": "picture"
        },
        "organization"
       ]
      }
     }
    ],
    "top": [
     {
      "type": "DropdownMenuLabel",
      "when": {
       "exists": [
        {
         "bind": "organizationsLabel"
