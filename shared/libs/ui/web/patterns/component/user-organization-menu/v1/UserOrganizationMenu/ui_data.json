   "items",
   "modes",
   "mode",
   "modeLayout",
   "modeLabel",
   "modeIcon",
   "compact",
   "trigger",
   "header",
   "manageLabel",
   "itemsLabel",
   "triggerIcon",
   "organizations",
   "activeId",
   "organizationsAs",
   "picture",
   "organizationsLabel",
   "addLabel"
