        "bind": "organizations"
       },
       "activeId": {
        "bind": "activeId"
       }
      },
      "when": {
       "not": [
        {
         "eq": [
          {
           "bind": "organizationsAs"
          },
          "menu"
         ]
        }
       ]
      },
      "on": {
       "change": [
        {
         "emit": {
          "event": "organizationChange",
          "payload": {
           "id": {
            "bind": "event.id"
           }
          }
         }
        }
       ]
      }
     },
     {
      "type": "DropdownMenuSub",
      "children": [
       {
        "type": "DropdownMenuSubTrigger",
        "props": {
         "data-testid": "user-organization-menu-organizations"
        },
        "children": [
         {
          "use": {
           "component": "OrganizationAvatar",
           "version": "latest"
          },
          "args": {
           "id": {
            "bind": "activeId"
           },
           "name": {
            "first": [
             {
              "pluck": [
               {
                "filter": [
                 {
                  "bind": "organizations"
                 },
                 {
                  "eq": [
                   {
                    "bind": "item.id"
                   },
                   {
                    "bind": "activeId"
                   }
                  ]
                 }
                ]
               },
               "name"
              ]
             }
            ]
           },
           "image": {
            "first": [
             {
              "pluck": [
               {
                "filter": [
                 {
                  "bind": "organizations"
                 },
                 {
                  "eq": [
                   {
                    "bind": "item.id"
                   },
                   {
                    "bind": "activeId"
                   }
                  ]
                 }
                ]
               },
               "image"
              ]
             }
            ]
           },
           "scale": "xs",
           "layout": "image",
           "width": "hug"
          }
         },
         {
          "type": "Stack",
          "props": {
           "dir": "col",
           "size": "fill"
          },
          "children": [
           {
            "type": "Text",
            "props": {
             "as": "span",
             "element": "type--body",
             "children": {
              "first": [
               {
                "pluck": [
                 {
                  "filter": [
                   {
                    "bind": "organizations"
                   },
                   {
                    "eq": [
                     {
                      "bind": "item.id"
                     },
                     {
                      "bind": "activeId"
                     }
                    ]
                   }
                  ]
                 },
                 "name"
                ]
               }
              ]
             },
             "position": "clip"
            }
           },
           {
            "type": "Text",
            "props": {
             "as": "span",
             "element": "type--body-extra-small",
             "children": {
              "concat": [
               {
                "count": [
                 {
                  "bind": "organizations"
                 }
                ]
               },
               " organizations"
              ]
             },
             "emphasis": "quiet"
            }
           }
          ]
         }
        ]
       },
       {
        "type": "DropdownMenuSubContent",
        "children": [
         {
          "use": {
           "component": "OrganizationItems",
           "version": "latest"
          },
          "args": {
           "organizations": {
            "bind": "organizations"
           },
           "activeId": {
            "bind": "activeId"
           }
          },
          "on": {
           "change": [
            {
             "emit": {
              "event": "organizationChange",
              "payload": {
               "id": {
                "bind": "event.id"
               }
              }
             }
            }
           ]
          }
         }
        ]
       }
      ],
      "when": {
       "eq": [
        {
         "bind": "organizationsAs"
