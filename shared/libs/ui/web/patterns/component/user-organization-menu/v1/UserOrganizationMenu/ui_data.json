{
 "id": "ui-data-pattern-component-user-organization-menu-userorganizationmenu",
 "version": 1,
 "uiNodeId": "ui-node-pattern-component-user-organization-menu-userorganizationmenu",
 "kind": "component",
 "name": "UserOrganizationMenu",
