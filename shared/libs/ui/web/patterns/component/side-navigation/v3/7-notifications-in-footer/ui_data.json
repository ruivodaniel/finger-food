{
 "id": "ui-data-pattern-component-side-navigation-7-notifications-in-footer",
 "version": 1,
 "uiNodeId": "ui-node-pattern-component-side-navigation-7-notifications-in-footer",
 "kind": "component",
 "name": "side-navigation-7-notifications-in-footer",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "side-navigation-7-notifications-in-footer",
  "version": 1,
  "surface": "web",
  "state": {
   "open": true,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light"
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "text": "The notifications entry is in the footer, above the user menu: the same place expanded and collapsed. The navigation expands inline: the page takes the width that is left.",
    "expand": "inline",
    "account": "separate",
    "withOrganizations": true,
    "withModes": true,
    "unread": 3,
    "notificationsAt": "footer"
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   }
  }
 }
}
