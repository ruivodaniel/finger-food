           ]
          },
          "sidebar-footer-two-rows"
         ]
        }
       }
      }
     ]
    },
    {
     "type": "SidebarWhen",
     "props": {
      "state": "mobile"
     },
     "children": [
      {
       "type": "Stack",
       "props": {
        "dir": "row",
        "align": "center",
        "justify": "between",
        "concept": "sidebar-topbar",
        "size": "fill"
       },
       "children": [
        {
         "type": "RemoteImage",
         "props": {
          "src": {
           "bind": "logoWide"
          },
          "alt": {
           "bind": "productName"
          },
          "concept": "logo-wide",
          "fit": "height"
         }
        },
        {
         "type": "SidebarTrigger",
         "props": {
          "startIcon": "menu",
          "aria-label": {
           "bind": "menuLabel"
          },
          "data-testid": "sidebar-menu-btn"
         }
        }
       ]
      }
     ]
    }
   ],
   "on": {
    "openChange": [
     {
      "emit": {
       "event": "openChange",
       "payload": {
        "open": {
         "bind": "event"
        }
       }
      }
     }
    ]
   }
  }
 }
}
