{
 "id": "ui-data-pattern-component-side-navigation-3-user-and-organization-menu",
 "version": 1,
 "uiNodeId": "ui-node-pattern-component-side-navigation-3-user-and-organization-menu",
 "kind": "component",
 "name": "side-navigation-3-user-and-organization-menu",
 "document": {
  "kind": "component",
  "schemaVersion": 1,
  "name": "side-navigation-3-user-and-organization-menu",
  "version": 1,
  "surface": "web",
  "state": {
   "open": false,
   "current": "dashboard",
   "org": "org-acme-corp",
   "mode": "light"
  },
  "root": {
   "use": {
    "component": "SideNavigationScreen",
    "version": "latest"
   },
   "args": {
    "open": {
     "bind": "state.open"
    },
    "current": {
     "bind": "state.current"
    },
    "org": {
     "bind": "state.org"
    },
    "mode": {
     "bind": "state.mode"
    },
    "text": "The header holds the logo alone. The footer holds the user and organization menu.",
    "expand": "inline",
    "account": "combined",
    "withOrganizations": true,
    "withModes": true
   },
   "on": {
    "openChange": [
     {
      "set": {
       "state": "open",
       "to": {
        "bind": "event.open"
       }
      }
     }
    ],
    "navigate": [
     {
      "set": {
       "state": "current",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "organizationChange": [
     {
      "set": {
       "state": "org",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "modeChange": [
     {
      "set": {
       "state": "mode",
       "to": {
        "bind": "event.id"
       }
      }
     }
    ],
    "back": [
     {
      "set": {
       "state": "current",
       "to": "back"
      }
     }
    ]
   }
  }
 }
}
