{
  "name": "@libs/mobile-components",
  "version": "0.1.0",
  "description": "Shared UI primitives and theme system for the Prowd mobile app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@libs/value-types": "workspace:*",
    "lucide-react-native": "^1.49.0",
    "react-native-qrcode-svg": "6.3.15",
    "react-native-svg": "15.15.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "typescript": "^5.0.0"
  }
}
